# ============================================================
# USER SERVICE - Mau cau hinh (.env.example)
# Sao chep file nay thanh .env va dien IP thuc te cua mang LAN
# ============================================================

# Cong chay cua service nay
SERVER_PORT=8081

# Database MySQL (IP cua may chay MySQL)
DB_HOST=192.168.?.?
DB_PORT=3306
DB_USER=root
DB_PASS=root

# Kafka Broker (IP cua may chay Kafka)
KAFKA_HOST=192.168.?.?
KAFKA_PORT=9092
